# 01_unix/tests/Dockerfile.cases.rhel — 항목별 양방향 케이스의 rhel 계열(Rocky Linux 9) 이미지(1.5.0 C1).
# Dockerfile.cases(debian:12)와 같은 케이스(fixtures/cases/cases.json)를 rhel 배포판에서 돌려, README 의 "rhel" 지원을
# 실제 배포판 경로(/etc/pam.d/system-auth·password-auth 의 authselect 심볼릭 링크, cronie, wheel 그룹 기본 존재 등)로 검증한다.
# 실행 방식(systemd PID 1, --privileged 없음)은 Dockerfile.cases 와 같다 - run_cases.sh 가 CASE_DISTRO=rhel 로 이 이미지를 쓴다.
# 추가 패키지는 판정 대상 파일을 만들기 위한 최소한만(cronie: U-37 crontab, iproute: U-38 ss, util-linux: case_run.sh 의 script).
# authselect 로 PAM 을 sssd 없는 기본 프로필(minimal)로 맞춘다 - RHEL 9 설치 기본값과 같은 "authselect 가 관리하는 PAM" 배치를
# 재현해, U-03 조치가 심볼릭 링크(/etc/pam.d/system-auth → /etc/authselect/system-auth)를 깨지 않는지 같이 본다.
# 컨테이너 이미지의 coreutils-single(/bin/sleep 등이 coreutils 를 부르는 셸 래퍼)은 실제 서버 설치(coreutils)와 달라 케이스의
# 가짜 데몬(sleep 사본을 서비스 이름으로 실행, U-42)이 뜨지 않는다 - 서버와 같은 coreutils 로 바꾼다.
FROM rockylinux/rockylinux:9

RUN dnf -y -q swap coreutils-single coreutils > /dev/null && \
    dnf -y -q install --setopt=install_weak_deps=False \
        procps-ng openssh-server systemd cronie iproute util-linux findutils diffutils authselect > /dev/null && \
    dnf clean all > /dev/null && \
    authselect select minimal --force > /dev/null && \
    systemctl mask dnf-makecache.timer systemd-tmpfiles-clean.timer fstrim.timer logrotate.timer \
        unbound-anchor.timer >/dev/null 2>&1; \
    systemctl disable crond.service sshd.service >/dev/null 2>&1; \
    systemctl mask getty@tty1.service console-getty.service >/dev/null 2>&1; true

COPY . /infra
WORKDIR /infra
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
