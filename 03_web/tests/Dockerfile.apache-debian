# 03_web/tests/Dockerfile.apache-debian — Debian 12 배포판 패키지(apache2) 레이아웃 회귀 테스트.
# 공식 httpd:2.4 이미지(소스 설치 레이아웃, ServerRoot 명시)만으로는 Debian/Ubuntu 레이아웃
# (/etc/apache2/apache2.conf, ServerRoot 주석, mods-enabled·sites-enabled·conf-enabled Include)을
# 검증하지 못해 Include 를 하나도 따라가지 못하는 버그(WEB-R1)를 놓쳤다. 데몬은 띄우지 않는다.
# 빌드 컨텍스트는 저장소 루트: docker build -f 03_web/tests/Dockerfile.apache-debian -t kisa-web-apache-debian-test .
FROM debian:12
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends apache2 \
    && rm -rf /var/lib/apt/lists/*
COPY . /infra
WORKDIR /infra
