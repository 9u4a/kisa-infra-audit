# 03_web/tests/Dockerfile.apache-rhel — RHEL 계열(Rocky Linux 9) httpd 패키지 레이아웃 회귀 테스트(1.5.0 C2, KNOWN_ISSUES L-04).
# 공식 httpd:2.4(소스 설치 레이아웃)·Debian apache2 와 다른 RHEL 레이아웃: /etc/httpd/conf/httpd.conf(ServerRoot "/etc/httpd"),
# conf.modules.d/*.conf Include, conf.d/*.conf IncludeOptional, 로그 /var/log/httpd(→ /etc/httpd/logs 심볼릭 링크). 데몬은 띄우지 않는다.
# 빌드 컨텍스트는 저장소 루트: docker build -f 03_web/tests/Dockerfile.apache-rhel -t kisa-web-apache-rhel-test .
FROM rockylinux/rockylinux:9
RUN dnf -y -q install httpd diffutils && dnf clean all
COPY . /infra
WORKDIR /infra
